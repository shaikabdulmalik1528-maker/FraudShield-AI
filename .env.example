# ==============================================================================
# FraudShield AI 3.0 — Environment Configuration Example (.env.example)
# Copy this file to .env and configure for your local or deployment environment.
# DO NOT COMMIT PRODUCTION SECRETS OR SENSITIVE CREDENTIALS TO VERSION CONTROL.
# ==============================================================================

# Application Settings
APP_NAME="FraudShield AI 3.0"
APP_ENV=development
DEBUG=True
LOG_LEVEL=INFO
API_V1_STR=/api/v1
API_V3_STR=/api/v3

# Authentication & Cryptographic Salts
# Generate secure 64-character random hex strings: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=fraudshield-super-secure-jwt-secret-key-change-in-prod-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
FRAUDSHIELD_TOKEN_SALT=REPLACE_WITH_SECURE_RANDOM_SALT_64_CHARS
FRAUDSHIELD_API_KEY_SALT=REPLACE_WITH_SECURE_API_SALT_64_CHARS

# Role-Based API Keys (Machine-to-Machine & Operator Access)
FRAUDSHIELD_ADMIN_API_KEY=fs3_admin_demo_dev_key_001
FRAUDSHIELD_SERVICE_API_KEY=fs3_service_demo_dev_key_002
FRAUDSHIELD_ANALYST_API_KEY=fs3_analyst_demo_dev_key_003
FRAUDSHIELD_PARTNER_API_KEY=fs3_partner_demo_dev_key_004

# Database Configuration
# Default to SQLite for zero-setup local development; use PostgreSQL for production:
DATABASE_URL=sqlite:///./fraudshield.db
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fraudshield_db

# Redis Streaming Feature Store (v3)
# Uses in-memory sliding window fallback if Redis is not running
FRAUDSHIELD_REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

# CORS Configuration (Comma-separated allowed origins)
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Machine Learning Artifact Paths (v1 Hybrid & v3 Enterprise)
MODEL_ARTIFACTS_DIR=artifacts
SUPERVISED_MODEL_PATH=artifacts/best_fraud_model.joblib
PREPROCESSOR_PATH=artifacts/preprocessor.joblib
ANOMALY_MODEL_PATH=artifacts/isolation_forest.joblib
METRICS_PATH=artifacts/model_metrics.json
THRESHOLD_PATH=artifacts/optimal_threshold.json
SHAP_BACKGROUND_PATH=artifacts/shap_background.joblib
V3_ARTIFACTS_DIR=backend/artifacts/v3

# Risk Engine Thresholds (Configurable 0 - 100)
LOW_RISK_THRESHOLD=30.0
HIGH_RISK_THRESHOLD=75.0
FRAUD_WEIGHT=0.75
ANOMALY_WEIGHT=0.25

# Rate Limiting & DoS Protection (v3)
RATE_LIMIT_SERVICE_PER_MIN=6000
RATE_LIMIT_ANALYST_PER_MIN=300
RATE_LIMIT_ADMIN_PER_MIN=60
MAX_REQUEST_BYTES=1048576

# Decision Engine Fail-Safe Policies (v3)
DEGRADED_FAILSAFE_ENABLED=true
DEGRADED_AMOUNT_THRESHOLD=500.0
DEGRADED_PROB_THRESHOLD=0.150

# ML Governance & Drift Monitoring (v3)
PSI_DRIFT_THRESHOLD_WARNING=0.10
PSI_DRIFT_THRESHOLD_CRITICAL=0.25
ROLLING_MONITOR_WINDOW_SIZE=1000
