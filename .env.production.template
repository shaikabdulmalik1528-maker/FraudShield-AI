# ==============================================================================
# FraudShield 3.0 Production Environment Configuration Template
# DO NOT COMMIT ACTUAL PRODUCTION SECRETS TO VERSION CONTROL
# ==============================================================================

# Application Environment
APP_ENV=production
APP_NAME="FraudShield AI 3.0"
LOG_LEVEL=INFO

# Security Secrets & Token Salts (Generate using `openssl rand -hex 32`)
FRAUDSHIELD_TOKEN_SALT=REPLACE_WITH_SECURE_RANDOM_SALT_64_CHARS
FRAUDSHIELD_API_KEY_SALT=REPLACE_WITH_SECURE_API_SALT_64_CHARS

# Role-Based API Keys (Machine-to-Machine & Operator Access)
FRAUDSHIELD_ADMIN_API_KEY=REPLACE_WITH_STRONG_ADMIN_KEY_MIN_32_CHARS
FRAUDSHIELD_SERVICE_API_KEY=REPLACE_WITH_PAYMENT_GATEWAY_SERVICE_KEY
FRAUDSHIELD_ANALYST_API_KEY=REPLACE_WITH_ANALYST_DASHBOARD_KEY

# Redis Streaming Feature Store
FRAUDSHIELD_REDIS_URL=redis://:REPLACE_WITH_STRONG_REDIS_PASSWORD@redis-store:6379/0
REDIS_PASSWORD=REPLACE_WITH_STRONG_REDIS_PASSWORD

# Rate Limiting & DoS Protection
RATE_LIMIT_SERVICE_PER_MIN=6000
RATE_LIMIT_ANALYST_PER_MIN=300
RATE_LIMIT_ADMIN_PER_MIN=60
MAX_REQUEST_BYTES=1048576

# Decision Engine Fail-Safe Policies
DEGRADED_FAILSAFE_ENABLED=true
DEGRADED_AMOUNT_THRESHOLD=500.0
DEGRADED_PROB_THRESHOLD=0.150

# ML Governance & Drift Monitoring
PSI_DRIFT_THRESHOLD_WARNING=0.10
PSI_DRIFT_THRESHOLD_CRITICAL=0.25
ROLLING_MONITOR_WINDOW_SIZE=1000
